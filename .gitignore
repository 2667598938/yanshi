# ============================================================
# 研时 · 仓库统一忽略规则（前后端共用；不要在子目录重复维护）
# ============================================================

# ---------- 环境变量与密钥 ----------
# 只保留示例文件，真实配置一律不进仓库
.env
.env.*
*.env
*.env.*
!.env.example
!**/.env.example
!**/*.env.example

# 证书 / 本地密钥
*.pem
*.key
jwt.key
**/jwt.key

# ---------- Python / 后端 ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 本地数据库、上传文件与备份
server/data/
server/storage_local/
*.sqlite
*.sqlite-*
*.sqlite3
*.db

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 日志 ----------
logs/
*.log

# ---------- 编辑器 / 系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# ---------- 本地手工备份 ----------
.backup/
