# 复制到 /etc/yanshi/server.env，属主 root:root、权限 600，真实文件禁止提交。
# Compose env_file 为原始格式：直接写值，不要加引号。
ENVIRONMENT=production
DATABASE_URL=sqlite:////var/lib/yanshi/prod.sqlite
IMAGE_DIRECTORY=/var/lib/yanshi/uploads
MAIL_DIRECTORY=/var/lib/yanshi/mail
JWT_SECRET=REPLACE_WITH_96_HEX_CHARACTERS
AI_KEY_ENC_SECRET=REPLACE_WITH_ANOTHER_96_HEX_CHARACTERS
PUBLIC_ORIGIN=https://duzhi.xin
CORS_ORIGINS=https://duzhi.xin
AUTH_PASSWORD_ONLY=false
AUTH_CHANNELS=email
AUTH_EMAIL_DOMAINS=
AUTH_QQ_NUMERIC_ONLY=false
# 如需开启 GitHub 登录，把 github 加进 AUTH_CHANNELS 并填写下列两项
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
REGISTRATION_OPEN=false
ACCOUNT_MAX_USERS=300
FEATURES=text_room,resource,post,inspiration,dream_school
# 同一域名跨网络通过 TURN 验收后，再把 av_room 加入 FEATURES。
ROOM_ICE_SERVERS=[]
ROOM_TURN_URLS=
ROOM_TURN_SECRET=
ADMIN_EMAIL=REPLACE_WITH_REAL_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
MAIL_CONSOLE=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=REPLACE_WITH_REAL_EMAIL
SMTP_PASSWORD=REPLACE_WITH_SMTP_AUTHORIZATION_CODE
SMTP_FROM=REPLACE_WITH_REAL_EMAIL
# 图片存储：local=服务器本地磁盘（默认，无需额外配置）；qiniu=七牛云（可选）
IMAGE_STORAGE=local
# 仅当 IMAGE_STORAGE=qiniu 时才需要填写，local 模式留空即可
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_S3_REGION=cn-south-1
AI_DAILY_LIMIT=100
AI_ALLOW_PRIVATE_HOSTS=false
AI_CUSTOM_HOSTS=
