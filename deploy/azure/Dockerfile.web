FROM node:22-alpine AS build
WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginx:stable-alpine
COPY deploy/azure/nginx-container.conf /etc/nginx/nginx.conf
COPY deploy/azure/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /build/dist/ /usr/share/nginx/html/
USER 101:101
EXPOSE 8080
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
