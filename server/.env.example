# 研时后端配置（复制为 .env 后修改；.env 不进 git）
# 开发默认：SQLite持久化限流/票据；仅账号密码登录，找回密码邮件可打印到控制台

ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/dev.sqlite

# 留空则首次启动自动生成 data/jwt.key（开发）；生产必须填 48 位以上随机串
JWT_SECRET=
JWT_ISSUER=yanshi
JWT_AUDIENCE=yanshi-web

PUBLIC_ORIGIN=http://localhost:27341
CORS_ORIGINS=http://localhost:27341,http://127.0.0.1:27341,http://localhost:5173,http://127.0.0.1:5173

# 内测仅账号密码登录；邮箱重置密码不受影响。其他登录必须先关闭此开关。
AUTH_PASSWORD_ONLY=true
# auth_password_only=false 时可配置其他登录渠道
AUTH_CHANNELS=email
# 邮箱验证码/注册允许的邮箱域名（逗号分隔；留空=不限制）
AUTH_EMAIL_DOMAINS=qq.com
AUTH_QQ_NUMERIC_ONLY=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
QQ_APP_ID=
QQ_APP_SECRET=
SMS_PROVIDER=

# 邮件：留空 + MAIL_CONSOLE=true 时，验证码打印到后端控制台并落到 data/mail
MAIL_CONSOLE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 图片存储：本地开发默认 local；生产改 qiniu 并填七牛 Kodo（私有 bucket）
IMAGE_STORAGE=local
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=sharearea
QINIU_S3_REGION=cn-south-1
QINIU_DOMAIN=

# AI严格使用本人BYOK；旧VOLC_*配置不再参与调用
# 用户 BYOK 的 Key 以 AES-256-GCM 加密存储；AI_KEY_ENC_SECRET 留空时退回 JWT_SECRET 派生
AI_KEY_ENC_SECRET=

# seed：初始管理员邮箱；ADMIN_PASSWORD 留空则随机生成并在控制台打印一次
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 首次seed默认关闭注册。已有数据库的registration_open由后台配置管理，不被seed覆盖。
REGISTRATION_OPEN=false
# 站点账号总数上限（含管理员）；0表示取消账号数量上限。每个房间仍独立限制4个席位。
ACCOUNT_MAX_USERS=100
FEATURES=text_room,resource,post,inspiration,dream_school
# video_small_room,cloud_video_room 默认不列入FEATURES；不含视频推流。

# 手机号登录与绑定需AUTH_CHANNELS包含phone；生产禁用控制台短信。
SMS_PROVIDER=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_REGION=ap-guangzhou

AI_DAILY_LIMIT=100
# 生产自定义AI代理的精确HTTPS域名白名单，逗号分隔，不包含协议或路径。
AI_CUSTOM_HOSTS=
# 仅非生产环境可以显式启用本机模型；默认禁止。
AI_ALLOW_PRIVATE_HOSTS=false

# Optional authenticated TURN relay; keep the shared secret server-side.
ROOM_TURN_URLS=
ROOM_TURN_SECRET=
ROOM_TURN_TTL=43200
