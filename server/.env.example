# 研时后端配置（复制为 .env 后修改；.env 不进 git）
# 开发默认：SQLite + 内存限流 + 邮件验证码打印到控制台，零外部依赖即可启动

ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/dev.sqlite

# 留空则首次启动自动生成 data/jwt.key（开发）；生产必须填 48 位以上随机串
JWT_SECRET=
JWT_ISSUER=yanshi
JWT_AUDIENCE=yanshi-web

PUBLIC_ORIGIN=http://localhost:27341
CORS_ORIGINS=http://localhost:27341,http://127.0.0.1:27341,http://localhost:5173,http://127.0.0.1:5173

# 登录渠道：一期只开 email；wechat / qq / phone 代码完整，填进 AUTH_CHANNELS 即启用
AUTH_CHANNELS=email
WECHAT_APP_ID=
WECHAT_APP_SECRET=
QQ_APP_ID=
QQ_APP_SECRET=
SMS_PROVIDER=

# 邮件：留空 + MAIL_CONSOLE=true 时，验证码打印到后端控制台并落到 data/mail
MAIL_CONSOLE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 图片存储：本地开发默认 local；生产改 qiniu 并填七牛 Kodo（私有 bucket）
IMAGE_STORAGE=local
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=sharearea
QINIU_S3_REGION=cn-south-1
QINIU_DOMAIN=

# AI：服务端兜底 Key（可选）+ 用户自填 Key 的加密主密钥
# 用户 BYOK 的 Key 以 AES-256-GCM 加密存储；AI_KEY_ENC_SECRET 留空时退回 JWT_SECRET 派生
VOLC_API_KEY=
VOLC_MODEL=doubao-seed-2-1-pro-260915
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_KEY_ENC_SECRET=

# seed：初始管理员邮箱；ADMIN_PASSWORD 留空则随机生成并在控制台打印一次
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
